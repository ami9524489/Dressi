rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Raw photos straight from the phone: the owner uploads, nobody else reads.
    match /users/{uid}/raw/{file} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 6 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Processed images are written by the server; the owner reads and may delete.
    match /users/{uid}/items/{file} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
